    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "^9.5.13",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
