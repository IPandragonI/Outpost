    "react": "19.3.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "stockfish": "19.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@serwist/turbopack": "^9.5.13",
